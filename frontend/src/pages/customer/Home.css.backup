@import "../../styles/redcross-theme.css";

.home-page {
  min-height: 100vh;
  background: var(--pure-white);
}

/* ========================================
   HERO SECTION - Red Cross Inspired
   ======================================== */

.hero-section {
  position: relative;
  min-height: 700px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3xl);
  padding: var(--space-4xl) 0;
  background: linear-gradient(135deg, #fff0f1 0%, #ffffff 50%, #e3f2fd 100%);
  overflow: hidden;
}

.hero-section::before {
  content: "";
  position: absolute;
  top: -50%;
  right: -20%;
  width: 800px;
  height: 800px;
  background: radial-gradient(
    circle,
    rgba(237, 27, 46, 0.08) 0%,
    transparent 70%
  );
  border-radius: 50%;
  pointer-events: none;
}

.hero-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: var(--space-5xl);
  position: relative;
  z-index: 2;
  animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-content h1 {
  font-family: var(--font-display);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: var(--font-weight-extrabold);
  color: var(--pure-black);
  line-height: 1.1;
  margin-bottom: var(--space-md);
  letter-spacing: -0.02em;
}

.hero-content h1 .emoji-hero {
  display: inline-block;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.hero-content p {
  font-size: var(--font-size-body-lg);
  color: var(--medium-gray);
  margin-bottom: var(--space-xl);
  max-width: 500px;
  line-height: 1.7;
}

.hero-bullets {
  list-style: none;
  margin-bottom: var(--space-xl);
}

.hero-bullets li {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
  font-size: var(--font-size-body);
  color: var(--dark-gray);
}

.hero-bullets li::before {
  content: "✓";
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  background: var(--red-cross-primary);
  color: var(--pure-white);
  border-radius: 50%;
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

.hero-cta-group {
  display: flex;
  gap: var(--space-md);
  flex-wrap: wrap;
}

.btn-shop-now {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 18px 40px;
  background: var(--red-cross-primary);
  color: var(--pure-white);
  text-decoration: none;
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-body-lg);
  border-radius: var(--radius-pill);
  transition: all var(--transition-base);
  box-shadow: var(--shadow-red);
  border: none;
  cursor: pointer;
}

.btn-shop-now::after {
  content: "→";
  font-size: 20px;
  transition: transform var(--transition-base);
}

.btn-shop-now:hover {
  background: var(--red-cross-dark);
  transform: translateY(-2px);
  box-shadow: var(--shadow-red-hover);
}

.btn-shop-now:hover::after {
  transform: translateX(4px);
}

.btn-secondary-hero {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 18px 40px;
  background: var(--pure-black);
  color: var(--pure-white);
  text-decoration: none;
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-body-lg);
  border-radius: var(--radius-pill);
  transition: all var(--transition-base);
  box-shadow: var(--shadow-md);
}

.btn-secondary-hero:hover {
  background: var(--charcoal);
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
}

/* Hero Image Section */
.hero-image-section {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: var(--space-5xl);
}

.hero-image-wrapper {
  position: relative;
  width: 100%;
  max-width: 600px;
  animation: slideInRight 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s backwards;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(40px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.hero-main-image {
  width: 100%;
  height: auto;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  object-fit: cover;
}

/* Floating Stat Cards */
.hero-stats {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.hero-stat-card {
  background: var(--pure-white);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  animation: floatIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.hero-stat-card:nth-child(1) {
  animation-delay: 0.4s;
  align-self: flex-start;
}

.hero-stat-card:nth-child(2) {
  animation-delay: 0.6s;
  align-self: flex-end;
}

@keyframes floatIn {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.hero-stat-number {
  font-size: clamp(36px, 5vw, 64px);
  font-weight: var(--font-weight-extrabold);
  color: var(--red-cross-primary);
  line-height: 1;
}

.hero-stat-label {
  font-size: var(--font-size-body-sm);
  color: var(--medium-gray);
  margin-top: var(--space-xs);
  font-weight: var(--font-weight-medium);
}

/* ========================================
   PRODUCTS SECTION
   ======================================== */

.products-section {
  padding: var(--space-5xl) 0;
  background: var(--pure-white);
}

.container {
  max-width: var(--container-max-width);
  margin: 0 auto;
  padding: 0 var(--container-padding);
}

.section-title {
  text-align: center;
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-extrabold);
  margin-bottom: var(--space-3xl);
  color: var(--pure-black);
  position: relative;
  padding-bottom: var(--space-md);
  letter-spacing: -0.01em;
}

.section-title::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 4px;
  background: var(--red-cross-primary);
  border-radius: var(--radius-pill);
}

/* Product Grid */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
}

.product-card {
    text-decoration: none;
    color: inherit;
    background: var(--pure-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    animation: fadeInScale 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.product-card:nth-child(1) {
  animation-delay: 0.1s;
}

.product-card:nth-child(2) {
  animation-delay: 0.2s;
}

.product-card:nth-child(3) {
  animation-delay: 0.3s;
}

.product-card:nth-child(4) {
  animation-delay: 0.4s;
}

.product-card:nth-child(5) {
  animation-delay: 0.5s;
}

.product-card:nth-child(6) {
  animation-delay: 0.6s;
}

.product-card:nth-child(7) {
  animation-delay: 0.7s;
}

.product-card:nth-child(8) {
  animation-delay: 0.8s;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(237, 27, 46, 0.1);

.product-image-wrapper {
  width: 100%;
    padding-top: 120%;
    position: relative;
    overflow: hidden;
    background: var(--ultra-light-gray);
}

.product-image-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.product-card:hover .product-image-wrapper img {
    transform: scale(1.05);
.product-info {
  padding: 20px;
  text-align: center;
  background: white;
}

.product-name {
  font-size: 15px;
  font-weight: 500;
  margin: 0 0 10px 0;
  color: #333;
  line-height: 1.4;
  min-height: 42px;
}

.product-price {
  font-size: 18px;
  font-weight: 700;
  color: #e31e24;
  margin: 0;
  letter-spacing: 0.5px;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  gap: 20px;
  margin-bottom: 40px;
  flex-wrap: wrap;
  align-items: center;
}

.search-box {
  flex: 1;
  min-width: 300px;
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 18px;
  font-size: 18px;
}

.search-box input {
  width: 100%;
  padding: 16px 50px 16px 50px;
  border: 2px solid #eee;
  border-radius: 12px;
  font-size: 15px;
  transition: all 0.3s ease;
  background: white;
}

.search-box input:focus {
  outline: none;
  border-color: #e31e24;
  box-shadow: 0 0 0 4px rgba(227, 30, 36, 0.1);
}

.clear-search {
  position: absolute;
  right: 15px;
  background: none;
  border: none;
  font-size: 18px;
  color: #999;
  cursor: pointer;
  padding: 5px;
}

.clear-search:hover {
  color: #e31e24;
}

.filter-options {
  display: flex;
  gap: 15px;
}

.filter-select {
  padding: 14px 20px;
  border: 2px solid #eee;
  border-radius: 10px;
  font-size: 14px;
  background: white;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 160px;
}

.filter-select:focus {
  outline: none;
  border-color: #e31e24;
}

.filter-results {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding: 15px 20px;
  background: #f8f9fa;
  border-radius: 10px;
}

.filter-results span {
  color: #666;
  font-size: 14px;
}

.btn-clear-filters {
  background: none;
  border: none;
  color: #e31e24;
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
}

.btn-clear-filters:hover {
  text-decoration: underline;
}

/* Loading & No Products */
.loading-container,
.no-products {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
  gap: 20px;
}

.loading-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #f3f3f3;
  border-top: 4px solid #e31e24;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .hero-content h1 {
    font-size: 36px;
  }

  .hero-content p {
    font-size: 16px;
  }

  .product-grid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
  }

  .section-title {
    font-size: 28px;
  }
}

/* Advanced Filter Bar */
.filter-bar.advanced {
  flex-direction: column;
  gap: 15px;
}

.filter-bar.advanced .search-box {
  width: 100%;
}

.filter-bar.advanced .filter-options {
  width: 100%;
  flex-wrap: wrap;
}

/* Price Range Filter */
.price-range-filter {
  display: flex;
  align-items: center;
  gap: 8px;
}

.price-range-filter span {
  color: #999;
}

.price-input {
  width: 120px;
  padding: 12px 14px;
  border: 2px solid #eee;
  border-radius: 8px;
  font-size: 14px;
  transition: all 0.3s ease;
}

.price-input:focus {
  outline: none;
  border-color: #e31e24;
}

.price-input::placeholder {
  color: #bbb;
}

/* Material Badge on Product */
.product-material {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-top: 50px;
  padding-top: 30px;
  border-top: 1px solid #eee;
}

.pagination button {
  padding: 12px 24px;
  background: white;
  border: 2px solid #e31e24;
  color: #e31e24;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.pagination button:hover:not(:disabled) {
  background: #e31e24;
  color: white;
}

.pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  border-color: #ccc;
  color: #ccc;
}

.pagination span {
  font-size: 14px;
  color: #666;
}

@media (max-width: 768px) {
  .filter-bar.advanced .filter-options {
    gap: 10px;
  }

  .price-input {
    width: 90px;
    padding: 10px;
  }

  .filter-select {
    min-width: 120px;
    padding: 10px;
  }

  .pagination {
    gap: 10px;
  }

  .pagination button {
    padding: 10px 16px;
    font-size: 13px;
  }
}
